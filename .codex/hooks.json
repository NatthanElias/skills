{
  "description": "Run the owning harness's skill checker after an edit in this repository.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/check_skill_edit.py\"",
            "statusMessage": "Checking the edited skill",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
